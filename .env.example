# Postgres connection string (Neon, Supabase, or any Postgres works).
# On Neon, copy the "pooled connection" string from your project dashboard.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google Gemini (used for the AI journal companion). Get a key at aistudio.google.com
GEMINI_API_KEY=""

# Optional: only needed if you enable "Sign in with Google"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
